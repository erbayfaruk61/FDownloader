<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FDownloader.App.Views.ToastNotificationWindow"
        Title="Bildirim"
        Width="430"
        SizeToContent="Height"
        MinHeight="85"
        MaxHeight="240"
        WindowStartupLocation="Manual"
        WindowDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        Background="Transparent">

    <Border Margin="8"
            Background="#1E293B"
            BorderBrush="#38BDF8"
            BorderThickness="1.5"
            CornerRadius="12"
            BoxShadow="0 10 30 0 #80000000">
        <Grid ColumnDefinitions="Auto, *, Auto" Margin="14,12">
            <!-- Sol: İkon -->
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#2510B981" VerticalAlignment="Top" Margin="0,2,12,0" x:Name="BorderIconBg">
                <TextBlock x:Name="TxtIcon" Text="✓" Foreground="#10B981" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Orta: Bilgi ve Butonlar -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock x:Name="TxtTitle" Text="Bildirim" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap" />
                <TextBlock x:Name="TxtFileName" Text="Mesaj içeriği" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" LineHeight="17" />

                <!-- İndirme dosyası aksiyon butonları (sadece dosya yolu varsa görünür) -->
                <StackPanel x:Name="PanelActions" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                    <Button x:Name="BtnOpenFolder" Click="OnOpenFolderClick" Content="📁 Klasörü Aç" FontSize="11" Padding="10,4" Background="#334155" Foreground="#E2E8F0" CornerRadius="4" BorderThickness="0" Cursor="Hand" />
                    <Button x:Name="BtnOpenFile" Click="OnOpenFileClick" Content="▶ Dosyayı Aç" FontSize="11" Padding="10,4" Background="#0284C7" Foreground="White" FontWeight="Medium" CornerRadius="4" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </StackPanel>

            <!-- Sağ: Kapat Çarpısı -->
            <Button Grid.Column="2" Click="OnCloseClick" Content="✕" FontSize="13" Foreground="#94A3B8" Background="Transparent" BorderThickness="0" VerticalAlignment="Top" Padding="4" Margin="4,-2,0,0" Cursor="Hand" />
        </Grid>
    </Border>
</Window>
