<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FDownloader.App.Views.ToastNotificationWindow"
        Title="İndirme Tamamlandı"
        Width="390" Height="110"
        WindowStartupLocation="Manual"
        WindowDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        Background="Transparent">

    <Border Margin="8"
            Background="#1E293B"
            BorderBrush="#38BDF8"
            BorderThickness="1.5"
            CornerRadius="12"
            BoxShadow="0 10 30 0 #80000000">
        <Grid ColumnDefinitions="Auto, *, Auto" Margin="14,10">
            <!-- Sol: İkon -->
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#2510B981" VerticalAlignment="Center" Margin="0,0,12,0" x:Name="BorderIconBg">
                <TextBlock x:Name="TxtIcon" Text="✓" Foreground="#10B981" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Orta: Bilgi ve Butonlar -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <TextBlock x:Name="TxtTitle" Text="İndirme Tamamlandı!" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" />
                <TextBlock x:Name="TxtFileName" Text="Dosya" FontSize="12" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" MaxLines="1" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Button x:Name="BtnOpenFolder" Click="OnOpenFolderClick" Content="📁 Klasörü Aç" FontSize="11" Padding="8,3" Background="#334155" Foreground="#E2E8F0" CornerRadius="4" BorderThickness="0" Cursor="Hand" />
                    <Button x:Name="BtnOpenFile" Click="OnOpenFileClick" Content="▶ Dosyayı Aç" FontSize="11" Padding="8,3" Background="#0284C7" Foreground="White" FontWeight="Medium" CornerRadius="4" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </StackPanel>

            <!-- Sağ: Kapat Çarpısı -->
            <Button Grid.Column="2" Click="OnCloseClick" Content="✕" FontSize="13" Foreground="#94A3B8" Background="Transparent" BorderThickness="0" VerticalAlignment="Top" Padding="4" Cursor="Hand" />
        </Grid>
    </Border>
</Window>
